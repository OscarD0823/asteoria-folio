    "mupdf": "^1.28.1",
    "opentype.js": "2.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.0",
