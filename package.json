{
  "name": "prisma-pdf",
  "version": "2.0.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite --host 127.0.0.1 --port 4178",
    "build": "node scripts/prepare-assets.mjs && tsc --noEmit && vite build && node scripts/package-source.mjs && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4178",
    "test": "tsx --test tests/*.test.ts",
    "desktop:build": "pnpm build && electron-builder --win nsis --x64",
    "desktop:dev": "electron .",
    "android:sync": "pnpm build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "lucide-react": "^0.468.0",
    "mupdf": "^1.28.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "main": "desktop/main.cjs",
  "author": "OscarD0823",
  "description": "Editor PDF local y privado para web, Android y Windows"
}
